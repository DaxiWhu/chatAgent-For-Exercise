# 灰度实例（app-canary）的专属覆盖。
# 这个文件里**只写灰度与稳定版不同的项**；其余配置继续从 ../../.env 继承。
#
# 用法：改完这里 → docker compose --env-file .env -f deploy/app/docker-compose.yml up -d app-canary
# 确认无问题后把 deploy/app/nginx.conf 里 canary 的 weight 调大（reload 生效）。

# 灰度可以换模型试效果（留空 = 用 .env 里的 LLM_MODEL）
# LLM_MODEL=deepseek-chat

# 灰度打开某个实验特性（例如先把上下文防护改成剥离策略观察）
# RAG_GUARD_ACTION=strip

# 灰度单独限流，避免实验流量把稳定版额度挤掉
# RATE_LIMIT_PER_MINUTE=30

# 灰度开 tracing 便于比对（稳定版可以留空）
# APP_RELEASE 由 compose 注入，不用在这里写
