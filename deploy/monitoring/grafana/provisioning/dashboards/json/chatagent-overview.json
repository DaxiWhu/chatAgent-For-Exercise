          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "各状态码请求速率",
      "description": "4xx 突然抬高通常是客户端在重试或有人在探测；5xx 才是服务端问题。",
      "datasource": {
