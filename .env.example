# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
#
# ⚠️⚠️ 用 compose 部署时**必须显式指定这个文件**：
#     docker compose --env-file .env -f deploy/app/docker-compose.yml up -d
#
# 原因（已核实的官方行为）：没有 `--env-file` 时，compose 从**项目目录**加载 .env，
# 而项目目录 = 「第一个 `-f` 文件所在目录」⇒ 用 `-f deploy/app/...` 时它是
# `deploy/app/`，**本文件（仓库根）根本不参与 `${VAR}` 插值**。
# 后果：**非口令类**是静默的 —— ALERT_SINK_*_WEBHOOK 为空、
# BACKUP_* / RETENTION_DAYS / CANARY_IMAGE 全部退回默认值，没有任何报错；
# **口令类则直接报错退出**（编排文件里它们是 `${VAR:?…}` 必填，见下方说明）。
#
# 自证方法（唯一可靠的）：
#     docker compose --env-file .env -f deploy/app/docker-compose.yml config | grep -i webhook
#
# 注意 `env_file:`（见 compose 里 app 服务那几处）是**另一回事**：它把变量灌进
# **容器**，不参与 compose 自身的插值。两者不能互相替代。

# --- 模型（与 chatAgent.ipynb 一致）---
AGNES_API_KEY=your_api_key_here
AGNES_API_BASE=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
# 生成调用的单次超时（秒）。主链路与 src/rag 的示例共用，改一处两处都变。
AGNES_TIMEOUT=30

# --- 检查点持久化（留空则用内存存储，重启丢状态）---
# 名称与 chatAgent.ipynb 保持一致，统一用 DB_URL
# PG 专用库/用户建法见生产化计划；密码请换成强密码
DB_URL=postgresql://langgraph_app:STRONG_PASSWORD@localhost:5432/langgraph_checkpoints?sslmode=disable

# --- PG 连接池（会话归属 / 账号 / 审核队列三个同步存储共用，见 app/pg.py）---
# 不配这三项也能跑：用默认值。但 PG_POOL_MAX 是**每副本**上限，
# 多副本部署时总连接数 = PG_POOL_MAX × 副本数，必须与 PG 的 max_connections 一起核算。
# PG_POOL_MIN=1          # 预热连接数（0 = 不预热，首个请求承担建连延迟）
# PG_POOL_MAX=8          # 每副本最多占用多少条 PG 连接
# PG_POOL_TIMEOUT=5      # 取不到连接时的等待上限（秒），超时即 503（fail-closed）

# --- RAG 语料目录（相对项目根目录）---
DOCS_DIR=./data

# --- 共享密钥 SERVE_API_KEY（**已于 2026-10-05 整体删除 —— 不要加回来**）---
# ⚠️ 这里**连空声明都不留一行**，这不是遗漏：
#   代码里已经没有对应路径（`X-API-Key` 不再被任何端点读取），而且启动期有一道
#   守卫 `app/main.py::_assert_no_legacy_auth_knobs` —— 只要环境里**存在**这个键
#   （`SERVE_API_KEY=` 留空也算），服务就**拒绝启动**并打印删除原因。
#
# 为什么是"删"而不是"留空默认关闭"：三条缺陷都是**结构性**的，只要配置项还在，
# 就总有人去配它（"配一个密钥"永远比"建账号"省事），于是它们会被重新引入：
#   1. **分不出是谁**：所有调用方共用同一个值 ⇒ 审计日志里 user 恒为空，审核留痕归不到人；
#   2. **撤不掉**：单值、无过期、无重叠轮换窗口 ⇒ 换值 = 改配置 + 重启 = 踢掉所有在线；
#   3. **带不了租户**：它没有载荷，租户只能靠请求头 X-Tenant-Id **自报且被采信**
#      ⇒ 持它者换一个请求头就能切检索分区、并绕过按租户分桶的配额。
#
# 脚本与 CI 改走：「账号密码 → POST /v1/auth/login → Bearer 令牌」。
#   实现见 `scripts/script_auth.py`；用法见 `examples/http_client.py` 的 login 子命令。

# =====================================================================
# 用户鉴权 —— **所有人类用户的唯一口径**
# =====================================================================
# 用户与租户的身份都放在 JWT 令牌载荷里（`sub` / `tenant` / `roles`）：
#   有租户就写进去，没有租户就是**空串**（含义见 config 的 `DEFAULT_TENANT`）。
# ⚠️ 凭证入口**只有** `Authorization: Bearer` 这一个 —— 没有并行的第二档，
#   也不存在"本段全部留空就退回免鉴权"的兜底：未配置时**所有业务请求都会 401**。
#   `X-Tenant-Id` 只是**一致性核对**（与令牌里的租户不符即 403），不是租户来源。

# ⚠️ 外部身份源（OIDC / JWKS）**已整体删除**（2026-10-05）：本服务不再验签任何
#   外部 IdP 签发的令牌，唯一能进门的凭证是它自己用 `AUTH_SESSION_SECRET` 签发的
#   会话令牌。所以 `AUTH_OIDC_` 开头的配置项一个都不存在了 —— 环境里只要残留任何一个
#   （**即使留空**），服务会**拒绝启动**（不静默忽略，是因为"配了却不生效"最难发现）。
#   删除理由：本项目实际的账号来源是"自助注册 + 申请加入租户 + 管理员批准"，
#   OIDC 一天也没被启用过，留着只是一条要长期维护与测试的身份入口。

# ---- 唯一的账号来源：种出**第一个管理员**（零额外依赖）----
# ⚠️ 2026-10-04 起语义变了：用户与租户住在**账号表**里（PG 的 users/tenants 表），
#    不再由这个变量扮演"用户表"。它现在的唯一作用是**解鸡生蛋**：
#    仅在账号表为空时，用这里的第一条建出一个管理员。
#    之后增删用户/租户一律走管理接口（POST /v1/admin/users 等），改这个变量无效。
# 格式：user:hash:tenant[:role|role][,user:...]
# 生成（不要手写）：python -m scripts.hash_password -u alice -t acme -r reviewer,admin
#   排障：python -m scripts.hash_password --check alice
# ⚠️⚠️ 整条值**必须用单引号包起来**。PBKDF2 串里含 `$`，而 docker compose 会对
#    未加引号的值做变量插值，`$<hex>` 段会被当成变量名替换成**空串** ⇒ 哈希报废
#    ⇒ 现象是「密码明明是对的却登不进去」，且**全程没有任何报错**。
#    单引号值按字面处理、不插值，所以照抄脚本输出即可：
# AUTH_USERS='alice:pbkdf2_sha256$600000$<salt_hex>$<hash_hex>:acme:admin'

# ---- 会话签发（登出/撤销能力依赖它）----
# ⚠️ 不配它就**无法签发/续期本服务会话 ⇒ 没有任何人能登录**（服务等同于不可用）。
#    生成：openssl rand -hex 32
# AUTH_SESSION_SECRET=
# access token 有效期（秒，默认 900）/ refresh token 有效期（秒，默认 604800）
# AUTH_ACCESS_TTL=900
# AUTH_REFRESH_TTL=604800
# ⚠️ AUTH_SINGLE_SESSION **已移除**（2026-10-01）：现在**允许同一用户在多台设备同时
#    登录**，每一台一个独立会话。旧语义「新登录踢旧登录」已不存在；即使 .env 里还留着
#    这个变量，也会被**静默忽略**（不再有任何效果）。
#    需要清场时用 POST /v1/auth/logout?all=true —— 只作用于当前凭证的那个用户。
#
# ⚠️ 多副本 / 多 worker 部署**必须**配 REDIS_URL：会话校验是**无条件**查存储的，
#    副本 A 签发的会话在副本 B 查不到 ⇒ 用户会**随机收到 401**（登录成功、隔几次
#    请求又要重登）。启动日志里 auth.user_auth.session_backend 应显示 redis。

# ---- 资源级授权：谁能审稿 ----
# ⚠️ 默认值 `reviewer`（**fail-closed**；2026-10-05 改 —— 此前默认空 = 不限制）。
#    不配此变量 = 只有带 reviewer 角色的人能审。要"不做角色校验"，必须**显式写空**：
#        AUTH_REVIEWER_ROLES=
#    而不是"不写"—— 不写会落到默认的 reviewer。
#    现在**对每一种身份都生效**：服务只剩用户凭证这一种身份来源，
#    共享密钥路径的"跳过角色检查"豁免已随该路径一起删除。
# AUTH_REVIEWER_ROLES=reviewer,admin

# ---- 资源级授权：谁能管用户与租户（增删改查 + 审批加入申请）----
# ⚠️ 默认值也是 fail-closed 的 `admin`：管理接口放开等于把"发权限"的能力交出去。
# 与上面审稿一致 —— 两项留空都等于**没人能做**，要放开必须显式写空：
#     AUTH_ADMIN_ROLES=
# 而不是"不写"—— 不写会落到默认的 admin。
# AUTH_ADMIN_ROLES=admin

# ---- 自助注册（默认**关闭**）----
# 打开后任何人可 POST /v1/auth/register 建账号。注册出来的账号**没有租户**，
# 而无租户在检索层只能读到**公共租户**（`RAG_TENANT`）的文档，读不到别的租户
# （见下面 RAG_TENANT 的说明）。所以这个开关的意义是"让这个决定看得见"：
# 要开放知识库给外部自助用户，得先想清楚公共租户里放什么内容。
# 注册后要加入某个租户，走 POST /v1/join-requests 提交申请、由管理员审批。
# AUTH_ALLOW_SELF_REGISTER=false

# ---- 密码策略（**新设**密码的长度门槛）----
# 下限默认 8 —— 行业基本线（NIST SP 800-63B 对"仅凭密码"的认证要求至少 8 位；
#   OWASP 也以 8 位为起点、推荐 12）。**允许配大，不允许配小**：代码里写成
#   `max(8, …)`，是因为"把弱密码策略写进 .env"这件事不该做得到。
# 上限 512 解决的是另一件事（PBKDF2 对超长输入的白白开销），与下限无关。
# ⚠️ 下限只约束**新设的密码**：登录、以及改密码时被验的旧密码都不受它约束 ——
#    否则早期设的短密码会被反锁在门外，连"改成合规密码"这一步都做不了。
# MIN_PASSWORD_CHARS=8
# MAX_PASSWORD_CHARS=512

# ---- 客户端如何知道"该重新登录了"----
# 令牌里的租户与角色是**签发那一刻的快照**。管理员改了租户/角色之后旧令牌会被清掉，
# 但**批准入租刻意不断会话**（改为提示重登）—— 此时客户端手上那张令牌仍在生效，
# 里面还是旧租户。所以客户端要调 GET /v1/auth/me 看 relogin_required / relogin_reason
# （GET /v1/join-requests/me 还会对刚批准的那条申请给出逐条标记 requires_relogin）。
# ⚠️ 这一步**必须实现**，不是可选装饰：不实现的话，用户"申请明明通过了却搜不到东西"，
#    只会反复重试或提工单 —— 而按当前口径无租户恰好能搜全库，他更难自己想明白。

# --- Embedding 配置（RAG 检索用，与 LLM 完全分开）---
# LLM 走上面的 AGNES_*；embedding 必须另指一个服务（agnes 不提供 embeddings 接口）。
# 指向任意 OpenAI 兼容的 /v1/embeddings，例如：
#   通义/百炼   https://dashscope.aliyuncs.com/compatible-mode/v1   text-embedding-v3
#   SiliconFlow https://api.siliconflow.cn/v1                       BAAI/bge-m3
#   本地 ollama http://localhost:11434/v1                           bge-m3
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 单次请求送多少条文本（各家上限不同：百炼约 10 条，硅基流动可更多）
# EMBEDDING_BATCH=10

# 查询侧指令前缀（只加在 query 上，文档侧不加）。
# BGE 系模型对此敏感，实测 bge-m3 + 8 条中文查询：无前缀 38%、中文指令 25%、
# 英文指令 62%。建议先不填，用你自己的语料实测后再决定。
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# --- RAG 检索后端 ---
# tfidf（纯本地关键词）| semantic（embedding 向量）| hybrid（两路 RRF 融合 + 可选 rerank）
# 实测（28 条中文查询 / 6 篇语料）：tfidf 75% > hybrid 61% > semantic 39%（Top1）
# 语料小、查询多照抄原文词时关键词最强；文档变长、说法多变时 hybrid 更稳。
RAG_EMBEDDING=hybrid

# --- 向量存储：稠密向量落 PostgreSQL（pgvector）---
# memory（默认，进程内 numpy 暴力余弦）| pg（PostgreSQL + pgvector 扩展）
# ⚠️ 用 pg 的收益：向量持久化，**重启不再重算 embedding**（内存版每次启动都要全量调 API），
#    并支持按 source 过滤。代价：需要一个装了 vector 扩展的 PG（见下方安装说明）。
# ⚠️ 若设了 pg 但扩展没装/连不上，会自动回退 memory 并打 WARNING，服务不会崩。
RAG_VECTOR_STORE=memory
# 表名。复用上面的 DB_URL 连接串，只是新建一张表。
# ⚠️ 换 embedding 模型（维度变化）时请换表名或手动清表，否则插入会因维度不符报错。
# PGVECTOR_TABLE=rag_chunks
# 向量索引类型：hnsw（默认，召回好）| ivfflat（省内存，大数据量）| none（不建，测试用）
# PGVECTOR_INDEX=hnsw
#
# pgvector 扩展安装（服务端，**管理员/超级用户执行一次**）：
#   A) Docker（最省事）：docker run -d --name pgv -p 5432:5432 \
#        -e POSTGRES_PASSWORD=*** pgvector/pgvector:pg16
#   B) 给现有 PG 编译：
#        1. 装 VS Build Tools（C++ 工作负载）
#        2. git clone --branch v0.8.0 https://github.com/pgvector/pgvector.git
#        3. 在 "x64 Native Tools Command Prompt" 里：
#             set PGROOT=D:\postgresql
#             nmake /F Makefile.win
#             nmake /F Makefile.win install
#        4. psql -U <superuser> -d <db> -c "CREATE EXTENSION vector"
#   （本项目的 rag_chunks 表会在首次写入时自动创建，只需先装好扩展。）

# --- 向量存储（可选）：Qdrant —— 稀疏 BM25 + 稠密 embedding 同库 ---
# 把上面的 RAG_VECTOR_STORE 设成 qdrant 即启用。与 pg 后端的差别：
#   **稀疏（BM25）与稠密（embedding）都进同一个 collection**，两路召回在 Qdrant 里完成，
#   融合仍由 retrieval.rrf_fuse 做（rerank 逻辑不变）。多租户隔离从「tenant 列 + WHERE」
#   平移成「payload 过滤」，语义等价。
# 收益：一个后端同时承载双路，免去"稀疏留在进程内现算"；ANN 走 HNSW，可水平扩展。
# 代价：需要单独运行一个 Qdrant 服务（不装/不配则自动回退 memory，服务不崩）。
# 起步最省事：docker run -d --name qdrant -p 6333:6333 -p 6334:6334 qdrant/qdrant
# ⚠️ 隔离口径（2026-10-04）：过滤值一律取 `Identity.tenant` ——
#    · 用户凭证（JWT）⇒ 来自**已验签的载荷**，这是唯一的可信来源；
#    · 脚本通行证 / 匿名 ⇒ 来自请求头 `X-Tenant-Id` **自报且被采信**（刻意的过渡口径）；
#    · **空串 ⇒ 不加租户过滤**，即能召回全部租户的文档。
#    绝不能把"自报的租户"当成本项目里的安全边界 —— 它只是配额分桶与数据分区的依据。
# RAG_VECTOR_STORE=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # 本地无鉴权可留空；托管/公网必填
# QDRANT_COLLECTION=rag_chunks
# 稠密维度（bge-m3=1024）。只影响首次建集合；集合已存在时以服务端为准并校验一致。
# QDRANT_DIM=1024
# 稀疏向量哈希维度（2^20）。越大碰撞越少、内存略增；改动会使已有稀疏向量失效，需换集合名重灌。
# QDRANT_SPARSE_DIM=1048576
# HNSW 建索引参数（只影响首次建集合）
# QDRANT_HNSW_M=16
# QDRANT_HNSW_EF_CONSTRUCT=100
# 向量落盘（省内存、检索变慢）。大语料/内存受限时置 1
# QDRANT_ON_DISK=0
# 单次请求超时（秒）
# QDRANT_TIMEOUT=10

# 混合检索：每路各取多少条候选送进融合
# RAG_HYBRID_POOL=10

# --- 切分 ---
# headings（默认，按 Markdown 标题切并把标题路径写进块）| recursive（纯递归）
# 实测把 chunk 从 500 收小到 300 且改成结构感知后，tfidf 照抄查询 Top1 由 88% 提升到 100%
# RAG_CHUNK_STRATEGY=headings
# RAG_CHUNK_SIZE=300
# RAG_CHUNK_OVERLAP=50
# .pdf 单独一套参数
# RAG_PDF_CHUNK_SIZE=800
# RAG_PDF_CHUNK_OVERLAP=200

# --- Docling 文档解析（.pdf / .docx）---
# 解析后端：docling（默认）| pdfminer（强制走旧的快速链路，用于排查对比）
# RAG_DOC_PARSER=docling

# PDF/docx 的正文切分走 Docling HybridChunker，按 token 计预算。
# 注意与上面的 RAG_CHUNK_SIZE 是两套单位（字符 vs token），不要互相覆盖。
# RAG_DOC_CHUNK_TOKENS=512

# 模型权重目录。先预下载（约 1GB+），再指向该目录即可离线运行，运行时不再依赖 HF 可达性：
#   python scripts/fetch_docling_models.py models/docling
# 不要用官方 download_models：它经 HF hub 下载，在 Windows（未开开发者模式）会把
# snapshots 下的符号链接退化成 0 字节空文件，且逐个 lock 的创建/删除会触发沙箱的
# 批量删除保护而中断。我们的脚本走纯 HTTP 直写最终位置，全程不删任何文件。
# 不需要 OCR（只解析电子版 PDF/docx）时可加 --skip-rapidocr，省一份权重。
# DOCLING_ARTIFACTS_PATH=./models/docling

# 推理设备：cpu | cuda（需装 CUDA 版 torch；本机当前是 CPU 版）
# DOCLING_DEVICE=cpu

# OCR：auto（无文字层才开，推荐）| on | off
# 开 OCR 需要 RapidOCR 权重，即上面的脚本默认会一起下到 <artifacts>/RapidOcr/；
# 若提前用了 --skip-rapidocr，这里开 OCR 会报 "RapidOCR artifacts not found"。
# DOCLING_OCR=auto

# --- OCR 参数（中文扫描件）---
# ⚠️ 这几项**显式写出来**，不要依赖库的默认值：docling 2.129 的 lang 默认恰好是 ch，
# 但那是巧合不是契约，上游改成 en 会让中文扫描件**静默**退化成乱码（不报错）。
# 语言必须与预取权重时一致（fetch 脚本默认 onnxruntime:ch），
# 换语言要重跑 fetch 脚本，否则报 artifacts not found。
# DOCLING_OCR_LANG=ch
# DOCLING_OCR_BACKEND=onnxruntime
# OCR 区域选择。实测合成扫描件三种模式都能捞回文字；
# **版面模型漏检的坏件**（歪斜/低对比/手写）只有 full 能兜住 —— 遇到坏件先试这个。
# default（= PDF_AWARE_LAYOUT_REGIONS，先版面簇再剔除文字覆盖）| layout | full | pdf_aware
# DOCLING_OCR_MODE=default
# 检测前放大倍数（RapidOCR 自身默认 3.0）。小字号多时可调大，代价是更慢
# DOCLING_OCR_SCALE=

# --- 图片 VLM 描述（批次6）---
# off（默认，按图计费，先算量：scripts/check_vlm.py --dry-run）| auto | on
# auto = 有 AGNES_API_KEY 才调；on = 强制调（缺 key 直接明确报错，不会"以为跑了其实没跑"）
# VLM_MODEL 必须支持视觉输入：agnes-2.5-pro 可以；agnes-image-* 是生图模型，不是看图
# VLM_MODEL=agnes-2.5-pro
# 单次运行最多描述多少张（防误开刷爆账单）
# VLM_MAX_IMAGES=50
# 送模型前的长边上限（方案：1600~2000px；小字号/细线不能靠降分辨率解决）
# VLM_MAX_SIDE=1600
# 描述结果缓存目录（键 = 图片内容 + 模型名，换模型会重算）
# RAG_VLM_CACHE_DIR=./data/.vlm_cache

# --- 切分侧改进（批次8）---
# 父子块（small-to-big）：检索用小块、送模型用命中块所在的上下文窗口。零成本，默认开。
# 用"连续窗口"而不是按章节分组 —— PDF 的 section 常为空，按节分组会退化成"永远是文档开头"。
# RAG_PARENT_CHILD=on
# RAG_PARENT_MAX_CHARS=1200

# Contextual Retrieval（Anthropic）：每块加一句"它在整篇文档里的位置与主题"前缀。
# ⚠️ 这是切分侧唯一**显著花钱**的改进（每块一次 LLM 调用），默认关。
# 收益实测方式：scripts/eval_retrieval.py --contextual（与不开的基线对比）
# 成本 ≈ 块数 × min(文档长度, RAG_CTX_DOC_CHARS)；有内容缓存，重复灌库不再付费。
# RAG_CONTEXTUAL=off
# ⚠️ 默认不用 agnes-2.0-flash：本账号实测它直接 429（免费档限流），一次都调不通。
# 2.5-pro 是**推理型**模型，会先花几百 token 推理，所以 MAX_TOKENS 必须放宽，
# 否则出现"finish_reason=length + 正文为空"且不报错。要省钱就换非推理型模型。
# CONTEXTUAL_MODEL=agnes-2.5-pro
# RAG_CTX_MAX_TOKENS=1200
# 并发度：串行时每块约 1 分钟，1000 块要十几小时；被限流就调小或分多次跑
# RAG_CTX_WORKERS=4
# RAG_CTX_MAX_CHUNKS=500
# RAG_CTX_DOC_CHARS=20000
# RAG_CTX_CACHE_DIR=./data/.ctx_cache
# 单次出站调用超时（秒）。切分是离线批量任务，不在请求热路径上，所以不设重试上限。
# RAG_CTX_TIMEOUT=60

# 公式转 LaTeX：每页都要跑公式模型，明显变慢，默认关
# DOCLING_FORMULA=0

# HuggingFace 端点。国内直连 huggingface.co 常超时，下载模型需走镜像。
# ⚠️ 镜像是社区服务，生产环境请自行确认可用性与合规性。
# HF_ENDPOINT=https://hf-mirror.com

# 切分用的 tokenizer：hf（与 embedding 模型对齐）| tiktoken（离线近似）| char（零依赖兜底）
# BGE_TOKENIZER=hf

# 图片/OLE 原件落盘目录（docx 解 zip 导出，PDF 裁剪也用它）。
# 目录名带源路径指纹，避免两份同名文档的媒体混在一起
# RAG_MEDIA_DIR=./data/.media

# docx 媒体抽取上限：单份文档最多导出多少个图片/OLE，防止异常文件写满磁盘
# RAG_DOCX_MAX_ASSETS=300

# docx 嵌入对象（OLE）内层正文的截断长度。内层可能是几十页的表格，
# 全灌进索引会把召回冲淡
# RAG_DOCX_OLE_TEXT_LIMIT=4000

# 图片描述用的 VLM（复用上面的 AGNES_API_KEY / AGNES_API_BASE）
# VLM_MODEL=agnes-2.5-pro

# --- rerank（可选精排）---
# 填了 RERANK_MODEL 后 hybrid 会自动挂上精排，调用失败会自动回退到融合顺序
# 留空则复用 EMBEDDING_API_BASE / EMBEDDING_API_KEY
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_BASE=
# RERANK_API_KEY=

# --- examples/ 教程脚本可选依赖（不参与生产）---
# OPENAI_API_BASE / OPENAI_EMBEDDING_API_KEY / OPENAI_EMBEDDING_MODEL
# ONEAPI_API_BASE / ONEAPI_EMBEDDING_API_KEY / ONEAPI_EMBEDDING_MODEL

# --- 引用（回溯核对）---
# 每条引用里回显的原文节选长度。**取的是保真原文（content）**，不是喂检索的加工文本。
# 默认 1000：会话状态会被 checkpointer 持久化，塞整块原文会让状态随会话线性膨胀。
# 要给用户看完整原文就调大它（代价是每轮状态更大）。
# RAG_CITE_SNIPPET_CHARS=1000

# --- 原页截图（引用返图）---
# auto（默认，PDF 开）| on | off
# 扫描件返回**整页原图**；表格/图表/图片/公式块返回**按 bbox 裁出的区域**；
# 电子版纯文字块不返回（没必要）。关掉后引用里仍有页码+坐标+保真文本，只是没有图。
# ⚠️ 代价：整页位图常驻内存（每页一张）。大批量灌库内存吃紧时设 off。
# DOCLING_PAGE_IMAGES=auto
# 裁剪时向外扩的边距（PDF 点）：太小会把贴着 bbox 的表格边框切掉
# RAG_CITE_IMAGE_MARGIN=8
# 页面渲染精度（默认 2.0 ≈ 144 DPI）。要更高清就调大，代价是内存与磁盘
# DOCLING_IMAGES_SCALE=2.0

# ==========================================================================
# 生产化横切配置（限流 / 配额 / 可观测 / 灰度 / 多租户 / 防护）
# 以下默认值都是"安全且不改变既有行为"的；标 ⚠️ 的项生产上必须处理。
# ==========================================================================

# --- ⚠️ 运行环境（P0）：development（默认）| production ---
# 它不是"标签"，而是**推导安全默认值的输入**（见 app/config.py）：
#   production  ⇒ ENABLE_DOCS=0（/docs、/redoc、/openapi.json 全 404）
#                  ＋ 启动期策略自检**直接拒绝启动**（没有用户鉴权等硬伤）
#   development ⇒ ENABLE_DOCS=1（文档端点公开可见）
#
# ⚠️ **鉴权要求不由它推导**：无论什么环境，"没有凭证 ⇒ 401"都是结构性的。
#    `REQUIRE_AUTH` 这个开关已随匿名兜底一起删除，**没有任何变量能关掉鉴权要求**。
#
# ⚠️ 刻意**以注释形式给出**，不要在这里写死：
#   - compose 部署会自动注入 production（见 deploy/app/docker-compose.yml），
#     写成 development 会**覆盖**它，等于把裸奔配置带上线（文档端点公开 + 自检降级）；
#   - 本地 `python -m app.serve` 需要保持 development（要开着 /docs 调试）。
# 只有"不用 compose、直接裸跑却要模拟生产"时才取消下面一行注释。
# APP_ENV=production

# --- 应用标识与灰度（TP2）---
# APP_VERSION：应用版本号。**唯一真源是仓库根的 `VERSION` 文件**，正常不用改这里。
# 改了 `VERSION` 之后跑 `python scripts/sync_version.py`，本行与 compose 的镜像 tag
# 会自动对齐；`tests/test_version_source.py` 断言三者一致（改一处漏一处就变红）。
# 只有在"临时跑一个与 VERSION 不同的版本"（例如手工验证某次灰度回滚）时才覆盖它。
APP_VERSION=0.2.0
# stable | canary；/health/live 会回显，用来核对流量落到了哪个版本
APP_RELEASE=stable

# --- 启动参数（仅 `python -m app.serve` 读取；命令行参数优先）---
# APP_HOST=0.0.0.0
# APP_PORT=8000
# 多 worker 会各自持有检索器与限流计数；配了 REDIS_URL 才能共享限流/配额
# APP_WORKERS=1
# APP_LOG_LEVEL=info
# APP_RELOAD=0

# --- ⚠️ 鉴权（P0）---
# 鉴权配置**不在这一节**，见文件上半部分「用户鉴权 —— 所有人类用户的唯一口径」。
# ⚠️ 共享密钥 `SERVE_API_KEY` 已于 2026-10-05 **整体删除**：本文件不再声明它，
#    任何部署配置（compose / k8s / CI 变量）里也不该出现 —— 环境里**存在**该键
#    （留空也算）会**拒绝启动**（守卫：`app/main.py::_assert_no_legacy_auth_knobs`）。
# 这里**刻意不再重复声明** `AUTH_*`：同一个键写两处的后果是 dotenv 后者覆盖前者，
# 而两处文案一旦不同步，读的人就会照着过时的那条做（这条分叉曾真实存在过）。
# 守卫：`tests/test_env_example.py::test_no_key_is_declared_twice`。

# --- 日志（P0）---
LOG_LEVEL=INFO
# json（生产，一行一 JSON，便于日志系统检索）| text（本地人眼友好）
LOG_FORMAT=json

# --- 指标（P1）---
# GET /metrics 输出 Prometheus 文本；设 0 则该端点返回 404
METRICS_ENABLED=1
# 只允许**私网 / 回环对端**抓取 /metrics（默认 1）。判据是 TCP 直连对端地址，
# **不是** X-Forwarded-For（那是客户端可写的头，用它做门禁等于用可伪造的值守门）。
# 为什么应用侧还要再拦一道：nginx 只是其中一条入口，容器直连映射端口、k8s NodePort、
# kubectl port-forward、Service Mesh 旁路都能绕开它 —— 门禁不能只挂在代理上。
# 设 0 = 不限制（仅在"应用端口绝不对外暴露"的部署形态下才可接受）。
METRICS_PRIVATE_ONLY=1

# --- 限流（P0）：**加权滑动窗口**，IP 与会话两个维度叠加 ---
# （固定窗口会让"上一分钟末尾用满 + 本分钟开头用满"在任意 60 秒内放行 2 倍额度，
#   60 秒对齐的重试循环会稳定命中 —— 2026-09-29 已改为加权滑动窗口）
RATE_LIMIT_ENABLED=1
# 每个 (客户端 IP, 路由) 每分钟上限
RATE_LIMIT_PER_MINUTE=120
# 会话（thread_id）维度：跨端点累计，防止一个会话同时刷 /chat 与 /review
RATE_LIMIT_BY_SESSION=1
RATE_LIMIT_SESSION_PER_MINUTE=120
# ⚠️ 多副本部署必须填 Redis：不填时每个副本各算各的，实际额度 × 副本数
REDIS_URL=
# ⚠️ 部署在反向代理后面时设 1，否则限流按代理 IP 统计（所有用户算成同一个）
TRUST_PROXY_HEADERS=0

# --- 用量配额（P1）：0 表示不限制 ---
QUOTA_ENABLED=1
# 单请求 token 预算；流式累计超限即停止继续生成（0 = 不限）
# ⚠️ 0 = 完全没有刹车：一次超长输入 / 模型跑飞就能**无限烧钱**。生产务必给非 0。
LLM_MAX_TOKENS_PER_REQUEST=8000
# 每租户每日 token 上限；请求进来先查，超了直接 429（0 = 不限）
# ⚠️ 0 = 被刷爆也不会有任何拦截，只能等账单来告诉你。按成本预算定。
# ⚠️ 名字里的 USER_ 是历史包袱：它管的是**整个租户**的日总量。
USER_DAILY_TOKEN_QUOTA=200000
# 每人每日 token 上限（0 = 不限）。与上一项**同时生效，两级都要过**。
# ⚠️ 只配上一项、不配这一项时，额度是整个租户共用一份：同租户里一个人先刷满，
#    其余人当天全部 429；而**没有租户**的账号（租户为空串）会共用一个桶，彼此互抢。
#    建议按「租户级额度 / 预计人数」来定（启动日志会在只配了一级时点名提醒）。
DAILY_TOKEN_QUOTA_PER_USER=0

# --- 请求级总超时（P1）：0 表示不限 ---
# ⚠️ 与上面两个配额管的不是一回事：它们管"产出多少 token"，这一项管"花多久"。
# 注意 AGNES/LLM client 自身的 timeout 只约束**单次调用**，而一次请求可以跑多轮
# （自评审不通过会再来一轮）⇒ 没有这一项时，单次请求的总时长**没有任何上界**。
# 超时后下发结构化 `timeout` SSE 事件再收流，已产出的正文照常交付。
# 生产建议 120（保守）～180（长任务多时）；不配（= 0）时启动期会打一条 warning。
#
# ⚠️ 它同时决定**发布时能放完多久的请求**：`app/serve.py` 的排空上界默认 = 本值 + 10s
# （未配本值时才退回 30s），而 `deploy/app/docker-compose.yml` 的 `stop_grace_period`
# 必须大于那个上界（现在是 210s）。三者的关系是「本值 ≤ 排空上界 < 容器宽限期」，
# 改一个就要核对另外两个 —— 只改本值不改容器宽限期，表现是发布时容器 SIGKILL 掉
# 在途 SSE（给进程记账/清理的机会都没有，日志里查不到）。
REQUEST_TIMEOUT_SECONDS=180

# --- SSE 心跳（保活帧，秒）。0 = 关 ---
# 首 token 之前可能静默几十秒（模型思考 + 工具执行），这段时间 TCP 上一个字节都
# 没有，反代的空闲超时会把连接当死连接掐掉 —— 而服务端还在正常跑，日志里没有错。
#
# 心跳是 SSE **注释行**（`: ping ...`），不是业务事件：EventSource 不会交给
# onmessage ⇒ 加它不改变对外事件契约，客户端不需要改。
#
# ⚠️ 必须**小于**反代的 `proxy_read_timeout`（deploy/app/nginx.conf 当前 300s）。
# 这里显式配置而不是吃 sse_starlette 的默认值（3.3.4 是 15s）：第三方默认值升版
# 会变，而症状（长回答偶发中断）没有任何报错。
SSE_PING_SECONDS=15

# --- 数据保留（合规与容量）---
# 超过这个天数的会话数据会被清理：
#   检查点（完整对话历史/草稿/评分）、审核队列记录、归属登记行。
#
# 0 = **不清理**（默认）。这是刻意的安全默认：删数据不可逆，给一个"看起来
# 合理"的天数意味着一次升级就静默删掉用户的历史会话。
#
# 判定依据是「最后活动时间」（session_owners.updated_at），不是创建时间 ——
# 否则一个创建得早、今天还在用的会话会被误删。
#
# ⚠️ 2026-09-30 起**有调度了**：compose 里新增 `retention-sweep` 服务（每天一次）。
# 在此之前清理只活在下面那段 cron 注释里 —— 也就是说**没有任何东西在跑它**，
# 三张表只增不减（"半年后才疼、疼起来最难查"的那一类）。
# 该服务在 RETENTION_DAYS=0 时**保持运行但不删任何东西**，并每轮播报"未配置"。
#
# 手工预演（默认 dry-run，加 --apply 才真删）：
#   python scripts/retention_sweep.py --days 30
#   python scripts/retention_sweep.py --days 30 --apply
RETENTION_DAYS=0

# --- 健康检查（P0）---
# readiness 探依赖的超时（秒）；超时即判不健康
HEALTH_READY_TIMEOUT=3

# --- Tracing（P1）：两组都留空则**彻底不产生 trace**（含关掉 SDK 默认的 OpenAI 后台上报）
#
# ⚠️ 别把"留空"读成"什么都不做"：官方 SDK 的 trace provider 第一次被访问时会自动
#    注册一个往 api.openai.com 上报的处理器（拿环境里的 OPENAI_API_KEY）。本项目
#    模型走自建客户端（AGNES_*），那条上报要么用错 key 把对话发给第三方、要么失败
#    被吞 —— 两种都不报错。所以留空时代码会显式 `set_tracing_disabled(True)`。
#
# ⚠️ 要用 Langfuse 还得**额外装两个包**（不在生产 requirements.txt 里）：
#      pip install langfuse openinference-instrumentation-openai-agents
#    接法是 OpenInference 的 OTel 插桩（见 PRODUCTION_CONFIG.md §3.1）；没装包时
#    启动日志会明确写"缺依赖"，后端回落 none，不会假装接上了。
#    官方文档的环境变量名是 LANGFUSE_BASE_URL，本项目的 LANGFUSE_HOST 会被同时
#    写成两个名字（新老 SDK 各认一个）。
#    接上之后每条 trace 带 session_id（会话）与 metadata.request_id（响应头里那个
#    值）⇒ 用户报 X-Request-ID 时能直接搜到链路，而不是只搜得到日志。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# LangSmith 只覆盖**仍在用 LangChain 的脚本**（如 scripts/eval_generation.py），
# agent 链路不进 LangSmith —— 它认的是 LangChain 回调，与官方 Agents SDK 不是一个体系。
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=chatagent

# --- 审核队列与通知（P2）---
# 需要人工审核时落队列表（PG 有 DB_URL 就落库，否则内存）并推送通知；
# 解决"那一刻没客户端在线 → 待审内容无人知晓"的问题
REVIEW_QUEUE_ENABLED=1
# 企微/飞书机器人或自建网关地址。留空 = 只落队列、不发通知
REVIEW_NOTIFY_WEBHOOK=
REVIEW_NOTIFY_TIMEOUT=5
# 通知线程数上限。原实现是"每条通知起一个线程"（无界）—— webhook 变慢时线程数
# 会随待审量线性增长，症状是"进程越来越慢"，看不出跟通知有关。
REVIEW_NOTIFY_WORKERS=2
# 通知积压上限。满了**丢弃并计数**（notify_dropped）而不是继续排队：
# 积压通知的价值随时间衰减，而待审记录本身已入库（通知只是提醒）。
REVIEW_NOTIFY_QUEUE_MAX=64
# generic（自建网关 JSON）| wecom（企业微信机器人）| feishu（飞书机器人）
REVIEW_NOTIFY_FORMAT=generic

# --- ⚠️ 告警送达网关（P0）：Alertmanager → 企微/飞书 ---
# deploy/monitoring 下 prometheus.yml / alerts.yml / alertmanager.yml 三层已齐，
# 但**最后一公里靠这里的凭据才通** —— 不填 = 告警只落进网关日志、送不到人，
# 而这在面板上看不出来（规则照样 firing）。
#
# 为什么要有网关这一层，而不是把机器人 URL 直接填进 alertmanager.yml：
#   ① Alertmanager 的配置**不支持环境变量插值**（不像 compose 有 ${VAR}），
#      凭据填进去就等于提交进版本库；
#   ② 企微/飞书的 payload 与 Alertmanager 原生 JSON 不同，直接填会被 400 拒掉。
#
# 通道表：左 = receiver 名（**必须与 alertmanager.yml 的 URL 末段一致**），
# 右 = 通道类型 wecom | feishu | generic（自建网关）。未在表里的 receiver 落到 default。
ALERT_SINK_ROUTES=oncall:wecom,security-oncall:wecom,cost-digest:wecom,default:wecom
# 三个通道对应三类接收人（值班 / 安全 / 成本），可以指向同一个机器人 ——
# 但**安全告警建议单独建群**，它与"成本超支"的处置人不同。
# 群机器人地址形如：
#   https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx   （企业微信）
#   https://open.feishu.cn/open-apis/bot/v2/hook/xxx            （飞书）
#
# ⚠️ 走飞书时，**不要给它开「签名校验」，也不要开「IP 白名单」**：
#    飞书官方**强烈建议**给自定义机器人加安全设置，所以这一步极容易顺手勾上；
#    但 `to_feishu()` 只发 `{msg_type, content}`，**不带 timestamp/sign** ⇒
#    开了签名校验就是每个请求都被拒（`19021 sign match fail`），现象是
#    "配置全对但没人收到"。IP 白名单同理：告警是宿主机出的网，家宽/云主机
#    重启换出口 IP 后会把自己挡在外面。
#    要收紧只用「**自定义关键词**」，填 `告警` —— `render_text()` 的第一行
#    一定是 `[告警] N 条` 或 `[已恢复] N 条告警已解除`，两种形态都含这两个字。
ALERT_SINK_WECOM_WEBHOOK=
ALERT_SINK_FEISHU_WEBHOOK=
ALERT_SINK_GENERIC_WEBHOOK=
# ⚠️ **刻意保持为空，别单独填它。** 非空时网关要求每个 POST 带
#    `X-Alert-Sink-Secret` 头且匹配，否则回 403 —— 而 `alertmanager.yml` 的四个
#    receiver **没有** `http_config`（那几行是注释掉的），根本不会送这个头。
#    ⇒ 填了它 = 把**全部告警**打成 403：Alertmanager 重试几次后放弃，
#    表现成"配置全对但没人收到"，网关日志里只有一行 403。
#    确实要开必须**两处一起改**：给四个 receiver 补 `http_config.http_headers`；
#    而 Alertmanager 不支持 `${VAR}` 插值，密钥只能写进配置文件 —— 又回到
#    "凭据进版本库"（这正是本网关要避免的事）。
#    当前暴露面本就有限：端口只绑回环（`127.0.0.1:8081:8080`），
#    剩下"同 compose 网络内其它容器可伪造告警"更适合用网络隔离解决。
ALERT_SINK_SHARED_SECRET=
#
# 自检（**别省这一步**：未配置的通道不报错、只记一条日志）：
#   docker compose --env-file .env -f deploy/app/docker-compose.yml run --rm alert-sink \
#     python alert_sink.py --selftest

# --- 多租户（P2）---
# 向量表 rag_chunks 有 tenant 列。这个值有两个作用，语义在 2026-10-05 收紧了：
#   ① **灌库默认租户**：`python -m scripts.ingest` 未显式指定租户时写进这一列的值；
#   ② **公共租户**：**没有租户的账号**（还没分配租户、或自助注册出来的）能读到的
#      唯一分区 —— 用户口径是「无租户可以查我们提供的公共租户文档，别的租户的不允许」。
#
# ⚠️ 留空 ≠ 不隔离：留空的后果是"没租户的账号**什么都读不到**"。
#    （旧口径：留空 = 不加过滤 = 能看全部租户的文档。那正是这轮要修掉的东西 ——
#     一个"还没分租户"的新账号默认就能读全库，作为生产默认站不住。）
# 所以生产上**建议填**一个具名值（本项目用 `public`），并把允许所有人看的内容灌进去。
RAG_TENANT=
TENANT_HEADER=X-Tenant-Id

# --- 提示词注入防护（P2）---
# 送模型前给检索资料加 <资料>…</资料> 边界 + 声明不执行其中指令（结构隔离，兜底）
RAG_GUARD=1
# warn（只告警不改内容，默认）| strip（剥离可疑句）| block（丢弃整块资料）
# ⚠️ 词表扫描只是辅助手段；文档里"忽略大小写"这类正常表述会被 warn 记一笔，属预期
RAG_GUARD_ACTION=warn

# --- 引用校验 ---
# `citations` 非空只说明"这一轮检索命中了东西"，**推不出**"答案用了它"、更推不出
# "答案有依据"。开启后每轮产出都会判：① 答案里的引用编号是否存在（编造引用）；
# ② 引用的源文件是否还在语料目录；③ 答案与引用文本的最低重叠。
RAG_CITATION_CHECK=1
# warn（记日志 + 指标 + 明细随响应带出去，默认）| block（**不下发引用**）
# ⚠️ block **只对确凿错误生效**（答案引用了不存在的编号）。重叠率低只是可疑 ——
# 模型改写幅度大一点就会低，拿它吞掉引用会把正常回答的引用一起吃掉。
RAG_CITATION_CHECK_ACTION=warn
# 答案与引用文本的最低 n-gram 重叠率。默认 0.05 刻意很低：这一层要抓的是
# "整段凭空生成"，不是"改写幅度大"。调高到 0.3 以上会开始误报。
RAG_CITATION_MIN_OVERLAP=0.05

# --- 在线答案质量采样（2026-10-03 新增；默认 0 = 关）---
# 为什么要有它：可用性/延迟看不见"答得变差"——模型变傻、检索召回下降时，
# QPS、P95、5xx 全部正常，只有用户投诉能发现。这一项按比例抽真实回答做**规则判定**。
# ⚠️ 零模型调用、不要密钥、毫秒级（`src/rag/answer_quality.py` 是正则 + 集合运算 +
#    引用编号比对）。LLM-as-judge 刻意留在离线/CI，不进请求路径。
# 开了之后告警 `OnlineHallucinationDetected` 才会真正工作 —— **没开时那两条序列
#    不存在（不是 0）**，规则一直挂 inactive，而这一点从告警界面上看不出来。
# 取值建议 0.02 ~ 0.1：
#   0.02 抽 2%（100 条查 2 条，够画趋势，用户无感）；
#   0.05 抽 5%（曲线更稳，推荐）；
#   0.1  抽 10%（样本最密，每个被抽中的请求多花几毫秒）。
# 抽太少（0.001 级）会让一天没几个样本、比率抖动；它是**趋势**指标，不需要全量。
RAG_ONLINE_QUALITY_SAMPLE=0

# --- 解析结果落盘缓存（P1）---
# 语料没变时跳过"重新解析 + 重新切分"（docling/OCR 是分钟级开销），多 worker 收益翻倍
RAG_PARSE_CACHE=1
# 留空 = 语料目录下的 .parse_cache（glob 的 * 不匹配点号开头目录，不会被当语料读进来）
RAG_PARSE_CACHE_DIR=

# --- 出站调用熔断（P1）：rerank / embedding 持续失败时快速失败，避免重试放大故障 ---
RAG_BREAKER=1
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30


# ===========================================================================
# 部署编排（docker compose）专用变量
# ===========================================================================
# 下面这些**不是 app 读的**，而是 `deploy/app/docker-compose.yml` 里的 ${VAR}
# 从项目根 .env 插值用的（所以不要在部署机 shell 里 export 一遍 —— 两处不一致
# 时以 shell 为准，会让人以为改了文件却没生效）。
#
# ⚠️ 口令类**刻意不提供默认值**（2026-10-05 改）。编排文件里它们是
#    `${VAR:?…}` 的**必填**写法 —— 这里留空 / 不设 ⇒ `docker compose` **直接报错退出**，
#    而不是退回一个 `123456` / `admin` 把库静默起起来。
#    理由：漏写 `--env-file` 已经是个静默失败，再叠一个弱口令默认值，后果就从
#    "配置没生效"升级成"**上线了，而且口令是公开在仓库里的**"；更糟的是数据卷
#    一旦初始化，口令就固化（改环境变量也换不掉，只能删卷重来）。
#    ⇒ 宁可起不来，也不要静默用弱口令起来。生成一个强口令：
#       openssl rand -base64 24

# PG 超级用户口令。**只在数据卷首次初始化时生效** —— 卷已存在时改它没有任何效果，
# 需要 ALTER USER 或删卷重来（详见编排文件顶部的说明）。
POSTGRES_PASSWORD=

# Redis 口令。Redis 默认无鉴权，而限流/配额就存在这里 ——
# 任何能进容器网络的东西都能改写计数键（= 直接绕过限流与配额）。
REDIS_PASSWORD=

# Grafana 面板口令（只影响 observability profile）。面板能读到全部指标与日志。
GRAFANA_PASSWORD=

# 定时备份节奏（backup-pg / backup-qdrant 两个循环容器共用的两个旋钮）。
#
# ⚠️ **间隔 × 份数 = 可回溯的时间窗**，改一个必须改另一个：
#     原来 24h × 14 = 14 天。把间隔压到 6h（RPO 24h→6h）而份数不动，
#     窗口会**静默缩到 3.5 天** —— 而那正是最容易需要"回到上周"的时候。
#     现在 6h × 56 = 14 天（与原来同一窗口，只是粒度更细）。
#     `tests/test_deploy_topology.py` 断言这个乘积 >= 7 天。
# 改 BACKUP_INTERVAL_HOURS 还要**同步改** `deploy/monitoring/alerts.yml` 里
# `BackupLoopFailing` 的 54000s（15h）阈值，否则会稳定误报或漏报。
#
# 真信号不是"容器在跑"，而是 `ls -lt backups/ | head` 的第一行是今天；
# 告警侧看 `backup_last_success_timestamp_seconds`（由备份循环写、
# node-exporter 的 textfile collector 读走）。
# 两个循环现在**对齐到同一槽位**执行（每轮 sleep 到下一个间隔整数倍时刻），
# 这样 pg 与 qdrant 的快照是同一时刻的 —— 恢复前用
# `python scripts/backup_manifest.py` 检查配对。
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=56

# --- 库容量采集（P1）---
# `pg-stats` 容器跑 `scripts/pg_table_stats.py` 的间隔（秒），默认 900（15 分钟）。
#
# 它把"库现在多大、涨得多快、是哪张表在涨"写成
# `backups/pg-tables.prom`，由 node-exporter 的 textfile collector 抓走
# （与备份指标同一条链路）。判据见 `deploy/CAPACITY.md` 第四节。
#
# ⚠️ 为什么必须有它：2026-10-03 起对话历史改为**永久保留**（RETENTION_DAYS=0，
#    上面那个清理服务整体停用）⇒ agent_messages / agent_sessions / 检查点三张表 /
#    review_queue / session_owners 全部只增不减。在那之前，整个部署面**没有一条指标
#    能回答"库多大、涨多快"**，唯一相关的 DiskSpaceLow 只在低于 15% 时响、
#    也不告诉你是哪张表在吃。
#
# ⚠️ 这个间隔必须**显著小于**告警窗口（6 小时）：否则 delta() 只有一两个样本，
#    算出来的增长斜率不可信，`PgTableGrowthFast` 会忽灵忽不灵。
# 体积查询走的是元数据（pg_class），开销可忽略；调小到 300 也是安全的。
PG_STATS_INTERVAL_SECONDS=900

# Qdrant 快照的份数单独可调（快照比 pg dump 大，默认窗口刻意短一些：
# 6h × 28 = 7 天。Qdrant 可从语料重建，pg 的检查点与审核记录不可再生）。
QDRANT_BACKUP_KEEP=28

# Qdrant 的容器内地址由编排硬编码为 http://qdrant:6333（照 DB_URL 的做法）。
# 上面 RAG_VECTOR_STORE=qdrant 那一节里的 QDRANT_URL 是给**本机直跑**用的，
# 两者互不干扰。

# --------------------------------------------------------------------------- #
# agent 能力链路（**唯一**的作答路径；文学 / PPT / 插图是它内部会叫的帮手）
# --------------------------------------------------------------------------- #
# **所有**请求都走 `src/agents`（OpenAI Agents SDK 原语编排：官方 `Agent` +
# `Runner`）—— 由前台-agent 自己判断该直接作答、叫工具（检索 / PPT / 插图），
# 还是把创作 handoff 给文学-agent。
#
# ⚠️ 这里**没有一个 `AGENTS_ENABLED` 开关**：它的语义是"关掉 agent、回落另一条
#     链路"，而回落目标已经随编排图一起删除（2026-10-20）。留一个只能取 true 的
#     开关，会让人以为可以关；更糟的是关掉之后进程照常启动、却答不出任何东西。
#     守卫：`tests/test_startup_guard.py::test_agents_enabled_knob_is_gone`。
#
# ⚠️ 想让这条链路"不工作"只有两种办法 —— 不装 `openai-agents`，或不配
#     `AGNES_API_KEY`。两者**都会让进程拒绝启动**（`app.main._assert_agents_ready`
#     报 `missing_sdk` / `missing_api_key`）：本服务只有这一条作答路径，没有第二套
#     "不依赖 SDK 也能答"的实现，所以"起得来但每个请求都答不出来"不是一个可接受
#     的部署状态。
#     依赖：pip install "openai-agents==0.20.0"
#     ⚠️ 版本被 `langchain-openai` 的 `openai<3` 约束钉住；装高了会在**导入期**
#        与 `openai` 冲突 ⇒ 装配失败（`build_failed`），照样起不来。

# 评审回灌的轮数上限。**必须与 evaluator instructions 里写的停止条件一致** ——
# 停止条件写在 prompt 里，代码只兜上界。
AGENT_MAX_ATTEMPTS=3

# 单次 Runner.run 内允许的 **LLM 调用次数**（官方语义，**不是对话轮次**！
# 设成对话轮次的量级比如 3，会让正常的"查两次资料"直接抛 MaxTurnsExceeded）。
AGENT_MAX_TURNS=12

# --- 一次运行的 token 预算（输入 + 输出）。0（默认）= 不限 ---
#
# 它管的是 AGENT_MAX_TURNS 管不到的那一半：轮数限的是**圈数**，不是**成本**。
#   一圈可能只花几百 token（闲聊），也可能花十几万（一次工具返回塞进一整份文档，
#   或历史本来就长）⇒ "12 圈"在一次长任务里可以是几十万 token。
#   没有这一项时，只有租户的**日**额度会在下一轮把用户挡在门外 —— 那时账单已经产生，
#   而且看起来是"用户额度不够"，不是"这一轮跑飞了"。
#
# 到线行为：**下一次模型调用之前**停下（`exit_reason="token_budget"`）。⚠️ 这一轮
#   不会形成答复正文（非流式下客户端什么都收不到；流式下已经推出去的增量留在客户端，
#   但不进会话历史）。已落盘的资产照常留在 asset 目录。
#
# ⚠️ 默认不限，与 REQUEST_TIMEOUT_SECONDS 同一口径：默认值配小了会大面积截断正常
#    长任务，而症状是"模型最近答得敷衍"——比账单偏高更难归因。生产建议给一个
#    比"正常长任务的实际用量"高 2~3 倍的值（先按 agent_run_tokens_total 的 p95 估）。
# ⚠️ **上游不回 usage 时它不生效**（累计恒为 0）。这是它唯一的静默失效方式 ⇒
#    配了预算却量不到 token 时，会单独计 `agent_run_tokens_unmeasured_total` 并打
#    warning（日志搜「一个 token 都没量到」）。看到那条先查网关的 usage 字段，
#    不要去调预算值。
# ⚠️ 这个预算**含旁路调用**（反思闸门 + 窗口压缩）。它们不经过 Runner 的 usage，
#    但账单上是实打实的钱 —— 尤其压缩，它要把被压掉的那段历史整段读一遍。
#    旁路单独上报在 `agent_bypass_tokens_total{source}`，两条曲线相加才是总额。
AGENT_RUN_TOKEN_BUDGET=0

# --- 一次运行的墙钟上限（秒）。0（默认）= 不限 ---
#
# AGENT_MAX_TURNS 限的是**圈数**，不是**时间**：一圈可能 200ms，也可能 50 秒。
# 没有这一项时，实际时长上界是**隐式**的 —— 12 圈 ×（模型 30s + 工具 20s）≈ 10 分钟，
# 而且谁也算不出来它是怎么来的。配了它之后才有"这类任务最多 3 分钟"这种话。
#
# 与另外两项的分工（对象不同，别合并）：
#   · AGENT_TIMEOUT_SECONDS     —— 一次**模型调用**（HTTP 客户端超时）；
#   · AGENT_TOOL_TIMEOUT_SECONDS —— 一次**工具执行**（线程池等待上界）；
#   · 本项                       —— 一次**运行**的合计（排队 + 重试 + 思考全算）。
#
# 到线行为：与 token 预算同一位置、同一后果（`exit_reason="run_timeout"`，
# 这一轮没有答复正文）。它排在预算**之前**判：两者常常同时超线，而"等太久"是
# 用户直接感知的那个，也常常是花钱多的原因。
AGENT_RUN_TIMEOUT_SECONDS=0

# 单次模型调用的超时（秒）。与主链路 ChatOpenAI(timeout=30) 对齐。
AGENT_TIMEOUT_SECONDS=30

# --- 单个工具执行的等待上界（秒）。0 = 不限 ---
# ⚠️ 与上面那个不是一回事：它管的是**一次工具调用**（检索 / 落盘 / 交付），
# 不是一次模型调用。两者独立可调：调模型超时不该牵动工具超时。
#
# 超时之后**不会**让整条任务失败：工具失败会被转成一句给模型的话（"可以换做法、
# 缩小范围，或者先做完其余部分"），模型自己决定怎么绕。所以它表现为"答案少一段
# 依据 + 延迟变长"，而不是报错 —— 这也是它必须单独告警的原因
# （`AgentToolStepTimeoutFrequent`）。
#
# 为什么必须有它：官方对同步工具用 `asyncio.to_thread`，而唯一的兜底是请求级
# 总时限（上面那项，默认 0 = 不限）⇒ 不配它就等于"工具卡住，请求永不结束"。
# 本项目另外把工具放进**独立线程池**（见 AGENT_TOOL_WORKERS），所以工具变慢
# 不会再拖累限流/落库/结算。
AGENT_TOOL_TIMEOUT_SECONDS=20

# --- 单次工具返回的字符上界。0 = 不限 ---
#
# 为什么需要它：kb_search 只限**条数**（top_k 上限 10），不限**字符**。而一条片段
# 有多长取决于切分后的 chunk —— 一页表格、一段长 PDF 单条就能上万字。于是"10 条"
# 可能是 2k 字符，也可能是 20 万字符。
#
# 没有被它封住时，唯一的约束是事后裁剪，而裁剪是**从最老的丢**：工具返回把窗口顶爆，
# 被丢掉的是用户原话 ⇒ 症状是"模型忘了自己在做什么"，看起来像模型跑偏，其实不是。
#
# 截断时会附一句"原文 N 字符 / 只给了前 M 字符 / 想看更多就缩小范围再查"，
# 让模型知道自己看到的是残片。超过上界的次数见 `agent_tool_result_truncated_total`。
AGENT_TOOL_RESULT_MAX_CHARS=8000

# --- 同一个工具失败几次之后改说"别再用它"。0 = 不启用 ---
#
# 为什么另起一条判据：重复计数与震荡检测的指纹都是「工具名 + 规范化参数」，
# 它们回答"同一个动作做了几次"。而"一个工具坏了、模型换着参数试了八次"是
# 八个不同指纹、各出现一次 ⇒ 两条判据都到不了阈值，**完全隐形**。
#
# 到线之后只是把回给模型的文案换成"不要再调用它，换一条路或如实说做不到" ——
# 不摘工具、不阻断运行（那一步失败不等于整件事做不成）。
AGENT_TOOL_FAIL_LIMIT=3

# 工具执行的线程数。0（默认）= 按 CPU 推导（min(32, cpu+4)，与 CPython 默认池同口径）。
# 这个池是**可牺牲的**：它被打满时的表现是"工具调用排队/超时"，而不是"服务不可用"。
# 只有在"工具以 IO 为主且并发很高"时才需要调大；调小不会省内存，只会让排队更早。
AGENT_TOOL_WORKERS=0

# 评审调用的重试次数（结构化输出解析失败是常见抖动；评审失败不该等于交付失败）。
AGENT_EVALUATOR_TRIES=2

# 工具动作清单：把一次运行内部的**每一步**记下来（工具名 / 参数指纹 / 成败 / 耗时）。
# 默认 **1（开）** —— 与"新能力默认关"的惯例相反，理由：它是**纯观察**。工具失败时
# 回给模型的文本仍由官方默认实现产出（一字不差），指标走旁路（没注入出口就是空操作）、
# 任何一步出问题都只降级为 debug 日志 ⇒ 它不动任何对外可见行为，"出问题"也没有
# 可退化的行为。而默认关掉等于"这个数永远没有数据"。
#
# 解决什么：一个 agent 节点 = **一次完整的运行**，模型在它内部可以来回十几次调用、
#   调十几次工具，而**图完全看不见这一段**（不落检查点、不介入）⇒ 某个工具三成的
#   调用在报错时，看板上呈现的是"工具次数正常、模型调用偏高"，指标会把人引向提示词，
#   而真凶是工具实现。开了它就能回答"哪个工具在失败、慢不慢"。
# 产出两个指标：agent_tool_result_total{tool,status}（**工具正确率**）、
#   agent_tool_duration_seconds{tool}。
# 关掉它（=0）：钩子与工具的错误处理函数都直接返回，不产生任何记录与指标。
AGENT_TOOL_STEPS=1

# agent 链路单轮检索返回的片段数上限。
AGENT_KB_TOP_K=3

# 交付物字符上限（出口护栏 `length_guardrail` 的阈值）。
AGENT_MAX_ANSWER_CHARS=8000

# PPT 大纲 / 插图资产的落盘目录。
# ⚠️ 容器部署要挂成卷，否则重启即丢 —— 客户端拿到过的资产路径会失效。
AGENT_ASSET_DIR=var/agent_assets

# --------------------------------------------------------------------------- #
# 多步防护：**在一次运行内部**发现"打转 / 卡住 / 跑偏"并介入
# （第一、二步 = 上面那个 AGENT_TOOL_STEPS；第三步 = 下面这一组）
# --------------------------------------------------------------------------- #
# 为什么需要：一个 agent 节点 = 一次完整运行，模型在里面可以来回十几次调用工具，
#   而**图完全看不见这一段**（不介入、不落检查点）⇒ 中间出了问题只能等它把
#   AGENT_MAX_TURNS 烧完。AGENT_TOOL_STEPS 让它"看得见"，这一组让它"能介入"：
#   够了就起一个后台任务问旁路模型，结论在下一次模型调用**之前**追加一条 system 消息。
#
# ⚠️ 旁路模型看到的证据里**带本轮原始目标**（用户那句话；人工打回轮是意见），
#   否则"跑偏"只能靠工具名猜意图。提醒与撤回文案里也会把目标**回读一次** ——
#   修正做法时唯一能参照的就是它。目标只在"提醒真的发生"时回读，不是每步都塞。
#
# ⚠️ **默认 0（关）**，而且这次的理由与 AGENT_TOOL_STEPS 相反、是本质的：
#   它**真会改变模型看到的东西** —— 先只是追加提醒（第 1 级），同一类问题到第 3 次
#   还会**删掉**出问题那一步及其之后的内容（第 2 级，见下）；再往后还确定"没救"时
#   会**直接中断本次运行**（第 3 级，见下）⇒ 打开后模型的可见输入变了、
#   出问题的退回代价不再是零。所以按"新能力默认关"的老规矩。
AGENT_MULTISTEP_GUARD=0

# 四个触发计数各设阈值，**谁先到谁触发**。阈值同时承担两个含义 ——
#   "什么时候开始看"与"多久再看一眼"：工具阈值 8 ⇒ 在第 8、16、24 次各触发一次。
# ⚠️ 写成"过了阈值就每次都发起"的后果不是"慢"：每次反思都是一次**真实模型调用**，
#    长任务里它会比主线还贵。写成"每个原因只触发一次"的后果是第四步的
#    "没纠正就升级"失去依据（没有第二次反思就判不出"同类问题又出现了"）。
AGENT_REFLECT_AFTER_TOOLS=8

# 重量级动作次数阈值。**重量级 = 叫专家（三个 as_tool）+ 落盘产出**
#   （save_text_asset / generate_image）。kb_search 与 review_draft **刻意不算**：
#   前者本来就该多查几轮，后者是只读流程步骤 —— 算进来会把正常流程误报成跑偏。
AGENT_REFLECT_AFTER_HEAVY=3

# 跨 agent 节点换人次数的阈值。⚠️ 当前拓扑里「前台 → 文学」最多发生**一次**
#   ⇒ 配 2 时它**永远不会触发**（刻意保留：加第三个节点就立刻有用）。
AGENT_REFLECT_AFTER_HOPS=2

# 同一个动作重复几次触发。**下限 2** —— 1 意味着"做一次就算重复"，那是常态。
AGENT_REFLECT_ON_REPEAT=3

# **来回震荡**转到第几圈触发（`A→B→A→B` 是 2 圈）。下限 2（1 圈不是震荡）。
#
# 为什么它比 AGENT_REFLECT_ON_REPEAT 更低、而且必须有：重复判据按**单个动作**计数，
#   `A→B→A→B` 时 A、B 各只有 2 次 ⇒ 重复判据（阈值 3）完全沉默。而"换一个工具再试
#   同一个思路"正是最典型的打转形态之一 —— 它比原样重试更像在想办法，所以更不容易
#   被人肉眼发现。⚠️ 把它配成 3 就等于让它永远晚于重复判据 ⇒ 退化成一条不生效的判据。
# 判据只看**尾部**：走出来之后（`A B A B C`）不再报 —— 它回答的是"此刻还在不在绕"。
AGENT_REFLECT_ON_OSCILLATION=2

# 跑到第几个动作时**无条件**检查一次（0 = 不启用这个检查点）。
# 为什么要有它：上面五个原因全是**计数型**。一个动作很快、一次没重复、也没失败的
#   模型，可以在第 2 步就把方向做错，然后一路顺畅地做完整件错事 —— 计数型全程沉默。
#   结果是"最贵的失败反而最不会被检查"。默认 2：第 1 次动作只是"开始了"，看不出方向；
#   第 3 次可能已经跑偏两轮。第 2 次是"方向刚成形、还没走远"那个点。
# ⚠️ 它只触发**一次**（无条件 ≠ 每圈：每圈都查会让反思比主线还贵）。0 只关掉这一个，
#    "交付那一刻"那个检查点不受它控制 —— 那个没有 0 这个选项。
AGENT_REFLECT_AFTER_STARTED=2

# 上限：一次运行里最多**注入**几次结论（第 1 级）。
AGENT_REFLECT_MAX_LEVEL1=2

# 上限：一次运行里最多**发起**几次反思。
# ⚠️ 必须 ≥ AGENT_REFLECT_MAX_LEVEL1 + AGENT_REFLECT_MAX_LEVEL2 + 2（两个强制检查点），
#    否则第 2 级永远轮不到、或者"交付前那一眼"被计数型判据先占光。
#    默认 5 = 2 + 1 + 2，正好够"提醒 2 次 + 撤回 1 次 + 早期/交付各看一眼"。
#    配错时**不报错、也不影响交付**（只有某些介入静默失效）⇒ 配置自检会打一条 warning；
#    强制点被额度吃掉时会记 agent_reflection_skipped_total{reason="cap"}。
AGENT_REFLECT_MAX_FIRES=5

# 上限：一次运行里最多**撤回**几次（第 2 级）。0 = 只提醒、绝不动上下文
#   —— 它不是另一个开关，总开关仍然只有 AGENT_MULTISTEP_GUARD 那一个。
AGENT_REFLECT_MAX_LEVEL2=1

# 第 2 级 · 退回（同类问题出现到**第 3 次** = 第 1 级上限 + 1 时触发）：
#   把出问题那一步**及其之后**的条目从模型看到的上下文里撤掉，让它回到那一步之前重新决定。
# ⚠️ 三条口径（每条都能单点改坏，各配守卫）：
#   ① **只撤没有副作用的动作**（检索 / 评审这类）。落盘类（写文件、生成插图）**不撤**：
#      撤回 = "让模型重做那一步"，而已经落盘的产物拿不回来 ⇒ 撤一次会得到两份。
#   ② 撤回是**持久**的（之后每一次模型调用都不再出现那一段）。⚠️ 这是它最容易写成
#      "看起来生效"的一处：能改模型输入的口子只有"每次调用之前"那一个，而官方运行状态里
#      的条目下一轮又会被拼回输入 ⇒ 只删一次 = 下一轮那条动作又回来了。
#   ③ 那一步已经不在输入里（被 token 裁剪或历史压缩吃掉）⇒ **第 3 级：停止重试**，
#      并计 agent_recovery_skipped_total{reason="not_found"} —— 能力退化要看得见。
#      ⚠️ 这条在 2026-10-10 改过口径：早先是"当次不退回、降级成一条提醒"，那等于让
#      它**悄悄过去**（模型照样在同一个地方打转，只是我们不再管它了）。
#
# 第 3 级 · 停止重试（2026-10-10 新增）：**该退却退不了**，或者**撤了也没用** ⇒
#   在下一次模型调用之前把这次运行**中断**（不是"跑完再说"）。
#   四个停因各对应一个具体的调参动作，会进日志与 agent_fallback_total{reason}：
#     capped（撤回额度用完：AGENT_REFLECT_MAX_LEVEL2=0 也落这里）
#     side_effect（那一步是落盘类，本来就不该撤）
#     not_fixed（撤过一次、同类问题**又**出现 ⇒ 撤回这个手段已经证伪）
#     not_found（那一步已被裁剪/压缩吃掉，定位不到就没法撤）
#   ⚠️ 顺序有意义：capped 排在 not_fixed 之前 —— 默认额度只有 1 次，同一个现象会先报
#      "没额度了"（那才是更具体、更该调的那个原因）。
#   ⚠️ **停止 ≠ 不交东西**：这次运行**已经产出的内容照交**，只是标明"部分结果"；
#      确实什么都没产出时，结局是 failed 并给开发侧一条 WARNING（要改代码）。
#      被护栏拦下的内容则连草稿**一起带给审核人**（转人工）。

# 反思自己那次模型调用的超时（秒）。**必须设**：它走旁路，不受 AGENT_MAX_TURNS 与
# 主线超时的约束。与 AGENT_HISTORY_COMPACT_TIMEOUT 独立 —— client 的超时是构造期
# 参数，两者没法共用同一个实例。
AGENT_REFLECT_TIMEOUT=20

# 每次模型调用前最多等几秒（等还没跑完的反思把结论交上来）。默认 2，0 = 不等。
# ⚠️ 它不是"只在收官前等"：唯一能改模型输入的口子只有"模型调用之前"，在那个位置
#    **看不到"这次是不是最后一次调用"**。阈值定得早时绝大多数情况等 0 秒，真正会等到
#    的只有快收尾那几次。没赶上的会计进 agent_reflection_late_total。
AGENT_REFLECT_WAIT_SECONDS=2

# --------------------------------------------------------------------------- #
# 工具审批：**会留下东西**的动作，执行前先问用户一声（加固阶段三）
# --------------------------------------------------------------------------- #
# 为什么需要：两个落盘工具（保存文件 / 生成图片）一旦执行，文件就留在磁盘上 ——
#   它们**不在退回白名单里**（删掉对话里那一步，磁盘上的文件不会消失），而现在唯一的
#   人工审核审的是**最终草稿**，等审到时文件早已落下 ⇒ 事前没有任何闸门。
#
# ⚠️ **默认 0（关）**（老规矩：新能力默认关）。打开它是对外可见的行为变化：
#   模型要落盘时会**停下来等人点头**，用户不点头就什么都做不成。
#
# 打开后新增一档结局 `awaiting`（**不是失败、也不算兜底**）：一次请求可能停好几次
#   （模型每请求一个高危动作就停一次）。它进 agent_task_outcome_total{outcome="awaiting"}，
#   但**不进** agent_fallback_total —— 兜底是"机制没兜住"，而待授权是正常运行被有意暂停。
#
# ⚠️ 两条实测得来的边界（不要按直觉改）：
#   · 审批是**逐个工具**的：同一条响应里没标审批的工具**照常执行完**（工具函数内部
#     打点证实）。想让"一处要批、整批都停"，SDK 不给这个开关，只能自己补；
#   · 因此**"高危"要逐个工具标，标一个不保护一批**。
AGENT_TOOL_APPROVAL=0

# 等用户点头的上限（秒，默认十分钟）。超时 ⇒ **终止这次任务**，界面上展示"用户授权
#   超时"，已产出的部分照交并说明"哪个动作因为没等到授权而没有执行"
#   （与"停止 ≠ 不交东西"同一口径）。
# ⚠️ 这个时限**是自己管的**：SDK 没有审批超时原语，中断之后那次运行会一直挂着。
#   实现是"待批项进审核队列时记下时刻，请求路径上惰性扫描到期项" —— 不用后台定时任务，
#   因为多副本下它会重复触发。
AGENT_APPROVAL_TIMEOUT_SECONDS=600

# --------------------------------------------------------------------------- #
# 跨轮对话历史（官方 Session 抽象，后端 = PostgreSQL；见 src/agents/session.py）
# --------------------------------------------------------------------------- #
# 送进模型的**输入预算**（token）。0 = 不限。
# ⚠️ 这是**输入**预算、不是整个窗口：工具清单与输出长度不在那个口子的视野里
#    （官方口子 `RunConfig.call_model_input_filter` 只看"指令 + 输入条目"），
#    所以取值必须留出余量。
# ⚠️ 2026-10-03 起取代了原来的"最近条数"口径：条数与 token 是**互不知道对方**的
#    两套判据（80 条可能只有 5k token，也可能 120k），而窗口是按 token 计的。
AGENT_HISTORY_TOKEN_LIMIT=100000

# 跨轮历史的**压缩**（2026-10-08 新增）。默认 **0（关）**。
# 为什么需要它：`messages` 既当"跨轮对话"又当"图状态里的一个字段"，而图状态
# **每走完一个节点就整份落一次盘** ⇒ 库里存的量随轮数**平方**增长（实测：轮数每
# 翻一倍，落盘量正好翻四倍）。压缩把"前 N 轮之前"的老历史换成一段摘要，把增长
# 阶从平方降到线性 —— 摘要仍然永久留在库里，**不是删除**。
# 两个固定入口共用一个开关（实现见 src/agents/compaction.py）：
#   ① 历史压缩：老历史超过保留轮数 ⇒ 换成摘要并**写回**（会话侧在请求开头后台跑，
#      下一轮生效；图状态侧是图里的一个节点，本轮生效）；
#   ② 窗口压缩：将要送进模型的输入 > 预算 × AGENT_HISTORY_COMPACT_RATIO ⇒
#      先把老的那段换成摘要再送（**只改这一次调用**）。
# 关掉它 = 行为与 2026-10-08 之前**逐字节一致**（这也是默认值）。
AGENT_HISTORY_COMPACT=0

# 压缩时**原样保留**最近多少轮。默认 5，**下限 1**（配 0 会被夹到 1）。
# ⚠️ 下限 1 不是随手定的：人工打回那一轮靠"原话已经躺在会话里"来决定不重传原话，
#    压成 0 会让第二遍只看到一句"人工审核意见：…"、**不知道在改什么**（且不报错）。
AGENT_HISTORY_KEEP_ROUNDS=5

# **窗口压缩**的触发线 = AGENT_HISTORY_TOKEN_LIMIT × 这个比例。默认 0.85（即 85%）。
# 换成窗口更大的模型时只改这里，不用改代码。
AGENT_HISTORY_COMPACT_RATIO=0.85

# 历史与检查点**同库**（都用 DB_URL 指的那个 PG），表由
# `python -m app.migrations apply` 建（agent_sessions / agent_messages）。
# ⚠️ 历史**没有过期时间、也不做清理**：用户隔多久回来都应该还能接上上一轮。
#    这是**产品口径**（"用户的数据你承诺留多久"），不是技术参数。
#    要改就得同时动 RETENTION_DAYS 与 scripts/retention_sweep.py。
#
# 可选（不写就用括号里的默认值）：
#   AGENT_SESSION_CACHE_MAX=256     进程内缓存的会话对象数上限
#                                   （防"构造陌生 thread_id 吃内存"这个 DoS 面）
#   AGENT_SESSION_PING_TIMEOUT=5    启动自检探测 PG 连通性的超时（秒）

# --------------------------------------------------------------------------- #
# 幂等键（客户端重试保护）—— 语义逐条对着 IETF 草案
# `draft-ietf-httpapi-idempotency-key-header-07` 实现，规范正文见
# deploy/IDEMPOTENCY.md（那份文档是**对客户端的承诺**，改代码时一起改）。
# --------------------------------------------------------------------------- #
# 客户端在请求头带 `Idempotency-Key` 时：首次正常执行；上一次**已完成**则把它的
# 响应原样重放；上一次**还在跑**回 409；同一个键换了载荷回 422。
# 不带这个头的请求行为与没有这套机制完全一致。
IDEMPOTENCY_ENABLED=1

# 键的保留时长（秒）——**同时**是"重放结果能存活多久"。客户端重试窗口必须短于它，
# 否则重试不再被拦，而这件事没有任何报错。
# ⚠️ 它也是过期策略（标准 2.3 要求公布），改它要同步 deploy/IDEMPOTENCY.md。
IDEMPOTENCY_TTL_SECONDS=600

# 进程内实现的最大条目数（配了 REDIS_URL 时不适用）。
# 键由客户端提供 ⇒ 无界缓存是一个可被利用的内存放大面。
IDEMPOTENCY_MAX_ENTRIES=10000

# 可选（不写就用括号里的默认值）：
#   IDEMPOTENCY_REQUIRE_KEY=0       是否**强制**要求该请求头：开启时缺失/非法回 400。
#                                   ⚠️ 默认关（该头本就是可选的）。开启前先确认
#                                   所有客户端都已按 deploy/IDEMPOTENCY.md 带键 ——
#                                   否则它们会当场全部 400。
#   IDEMPOTENCY_MAX_KEY_CHARS=128   键的最大长度（超长/含引号或反斜杠 → 400）
#   IDEMPOTENCY_MAX_BODY_BYTES=262144
#                                   单个键最多缓存多少字节的重放内容。超过则只记
#                                   "已完成"、不再缓存正文（那种情况重试回 409 指路
#                                   而不是重放）。它是**内存换重放能力**的取舍开关。
#   IDEMPOTENCY_DOC_URL=            规范文档的 URL。400/422 的响应体要带一个指向
#                                   文档的链接（标准 2.7 的 SHOULD）。留空则不带
#                                   Link 头。生产建议填你的对外文档地址。
